<?xml version="1.0"?>
<ruleset name="EME Event Attendee Export">
    <description>WordPress Coding Standards for the EME Event Attendee Export one-off plugin.</description>

    <!-- Scan only plugin source directories -->
    <file>includes/</file>
    <file>admin/</file>
    <file>eme-event-attendee-export.php</file>
    <file>uninstall.php</file>

    <!-- Exclude tests (harness stubs) -->
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- Use WordPress-Core as the base -->
    <rule ref="WordPress-Core">
        <!-- Same relaxations as WP Smart Forms: class files are named
             class-exporter.php / class-admin.php, and table names (built
             from the trusted $wpdb prefix via esc_sql) are interpolated
             into otherwise prepared queries. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
        <exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>
    </rule>

    <arg name="extensions" value="php"/>
</ruleset>
